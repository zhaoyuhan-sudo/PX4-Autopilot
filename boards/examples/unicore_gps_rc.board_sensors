#!/bin/sh
#
# Unicore GPS 板级启动脚本示例
# 将此文件复制到 boards/<vendor>/<board>/init/rc.board_sensors
#

# ============================================================================
# Unicore GPS 配置示例
# ============================================================================

# 基本配置 - 使用默认串口
# DEVICE: GPS 模块连接的串口设备
# BAUDRATE: 波特率（0 表示自动检测）
# PROTOCOL: 协议类型（unicore）

DEVICE="/dev/ttyS1"
BAUDRATE="115200"
PROTOCOL="unicore"

# ============================================================================
# 启动 GPS 模块
# ============================================================================

echo "Starting Unicore GPS on $DEVICE..."

# 方式 1: 简单启动（推荐用于调试）
gps start -d $DEVICE -p $PROTOCOL -b $BAUDRATE

# 方式 2: 使用参数配置（推荐用于生产环境）
# 取消以下注释以使用参数配置
#
# # 设置参数
# param set GPS_1_PROTOCOL 7  # 7 = Unicore
# param set GPS_1_BAUD $BAUDRATE
# 
# # 启动 GPS（使用参数）
# gps start -d $DEVICE

# ============================================================================
# 验证 GPS 是否正常启动
# ============================================================================

# 等待模块初始化
sleep 1

# 检查模块状态
gps status

echo "Unicore GPS startup complete"
